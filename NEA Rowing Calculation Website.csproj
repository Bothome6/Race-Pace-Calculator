    <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
    <UserSecretsId>87836c4e-111f-4f6d-9d1b-6b8600398634</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
