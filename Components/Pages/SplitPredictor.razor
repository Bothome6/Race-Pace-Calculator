    private void Calculate100()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(100.0 / distance, 2.0));
        int minutes = (int)(predic / 60);
        double seconds = predic% 60;
        firstResultText = $"{minutes}:{seconds:F0}";
    }
