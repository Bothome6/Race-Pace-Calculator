@page "/predicted-split"
@rendermode InteractiveServer

<h3>Split Predictor</h3>

<div>
    <label>Distance (meters):</label>
    <input type="number" @bind="distance" />
</div>

<h4>Target Time</h4>

<div>
    <label>Minutes:</label>
    <input type="number" @bind="targetMin" />
</div>

<div>
    <label>Seconds:</label>
    <input type="number" @bind="targetSec" />
</div>

<button @onclick="CalculateSplit">Calculate</button>

@if (resultText != null)
{
    <p><b>Your split: @resultText</b></p>
}

<h4>Athlete Profile</h4>

<button @onclick="SprinterCalculation">Sprinter</button>
@if (resultText != null)
{
    <p><b>Your split: @sprinterResultText</b></p>
}

<button @onclick="BalanceCalculation">Balance</button>
@if (resultText != null)
{
    <p><b>Your split: @balanceResultText</b></p>
}

<button @onclick="EnduranceCalculation">Endurance</button>
@if (resultText != null)
{
    <p><b>Your split: @enduranceResultText</b></p>
}

@code {
    private int distance;
    private int targetMin;
    private int targetSec;
    private string? resultText;
    private string? sprinterResultText;
    private string? balanceResultText;
    private string? enduranceResultText;



    private int CalculateSplitTime()
    {
        int targetTime = (targetMin * 60) + targetSec;
        double pace = (double)targetTime / distance * 500; 
        return (int)pace;
    }
    private void CalculateSplit()
    {
        int time = CalculateSplitTime();
        int minutes = (int)(time / 60);
        double seconds = time % 60;
        resultText = $"{minutes}:{seconds:F0}";
    }

    private void SprinterCalculation()
    {
        int time = CalculateSplitTime();
        int predic = (int)Math.Pow(time * (5000.0 / distance), 1.08);
        int minutes = (int)(predic / 60);
        double seconds = predic % 60;
        sprinterResultText = $"{minutes}:{seconds:F0}";
   }

    private void BalanceCalculation()
    {
        int time = CalculateSplitTime();
        int predic = (int)Math.Pow(time * (5000.0 / distance), 1.06);
        int minutes = (int)(predic / 60);
        double seconds = predic% 60;
        balanceResultText = $"{minutes}:{seconds:F0}";

        @* return predic; *@
    }

    private void EnduranceCalculation()
    {
        int time = CalculateSplitTime();
        int predic = (int)Math.Pow(time * (5000.0 / distance), 1.04);
        int minutes = (int)(predic / 60);
        double seconds = predic % 60;
        enduranceResultText = $"{minutes}:{seconds:F0}";

        @* return predic; *@

    }
}
