@page "/predicted-split"
@rendermode InteractiveServer

<h3>Split Predictor</h3>

<div>
    <label>Distance (meters):</label>
    <input type="number" @bind="distance" />
</div>

<h4>Target Time</h4>

<div>
    <label>Minutes:</label>
    <input type="number" @bind="targetMin" />
</div>

<div>
    <label>Seconds:</label>
    <input type="number" @bind="targetSec" />
</div>

<button @onclick="CalculateAll">Calculate</button>

@if (resultText != null)
{
    <p><b>Your split: @resultText</b></p>
}

<h4>Predicted Profile</h4>

        <table>
        <tr>
            <th>100 M</th>
            <td>@firstResultText</td>
        </tr>
        <tr>
            <th>500 M</th>
            <td>@secondResultText</td>
        </tr>
        <tr>
            <th>1000 M</th>
            <td>@thirdResultText</td>
        </tr>
        <tr>
            <th>2000 M</th>
            <td>@resultText</td>
        </tr>
        <tr>
            <th>5000 M</th>
            <td>@fiveResultText</td>
        </tr>
        <tr>
            <th>10000 M</th>
            <td>@sixResultText</td>
        </tr>
    </table>


@code {
    private int distance;
    private int targetMin;
    private int targetSec;
    private string? resultText;
    private string? firstResultText;
    private string? secondResultText;
    private string? thirdResultText;
    private string? fiveResultText;
    private string? sixResultText;



    private int CalculateSplitTime()
    {
        int targetTime = (targetMin * 60) + targetSec;
        double pace = (double)targetTime / distance * 500; 
        return (int)pace;
    }

    private void CalculateAll()
    {
        CalculateSplit();
        Calculate100();
        Calculate500();
        Calculate1000();
        Calculate5000();
        Calculate10000();

    }
    private void CalculateSplit()
    {
        int time = CalculateSplitTime();
        int minutes = (int)(time / 60);
        double seconds = time % 60;
        resultText = $"{minutes}:{seconds:F0}";
        
    }

    private void Calculate100()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(100.0 / distance));
        int totalTime = predic * 100 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        firstResultText = $"{minutes}:{seconds:F0}";
    }
    private void Calculate500()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(500.0 / distance));
        int totalTime = predic * 500 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        secondResultText = $"{minutes}:{seconds:F0}";
    }
    private void Calculate1000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(1000.0 / distance));
        int totalTime = predic * 1000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        thirdResultText = $"{minutes}:{seconds:F0}";
    }
    private void Calcule2000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(2000.0 / distance));
        int totalTime = predic * 2000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        resultText = $"{minutes}:{seconds:F0}";
    }
    private void Calculate5000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(5000.0 / distance));
        int totalTime = predic * 5000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        fiveResultText = $"{minutes}:{seconds:F0}";
    }
    private void Calculate10000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log(10000.0 / distance));
        int totalTime = predic * 10000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        sixResultText = $"{minutes}:{seconds:F0}";
    }
}
