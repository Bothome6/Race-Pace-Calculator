@page "/predicted-split"
@rendermode InteractiveServer

<h1>Split Predictor</h1>
<p>Model-based estimate tool for logging and planning: choose power-law and project finish times.</p>

<div>
    <label>Distance (meters):</label>
    <input type="number" @bind="distance" />
</div>

<h4>Target Time</h4>

<div>
    <label>Minutes:</label>
    <input type="number" @bind="targetMin" />
</div>

<div>
    <label>Seconds:</label>
    <input type="number" @bind="targetSec" />
</div>

<div>
<button class="CalculateButton" @onclick="CalculateAll">Calculate</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div>
        <label class="errormessage">@errorMessage</label>
    </div>
}

<h4>Predicted Profile</h4>

        <table>
        <tr>
            <th>100 M</th>
            <td>@firstResultText</td>
        </tr>
        <tr>
            <th>500 M</th>
            <td>@secondResultText</td>
        </tr>
        <tr>
            <th>1000 M</th>
            <td>@thirdResultText</td>
        </tr>
        <tr>
            <th>2000 M</th>
            <td>@resultText</td>
        </tr>
        <tr>
            <th>5000 M</th>
            <td>@fiveResultText</td>
        </tr>
        <tr>
            <th>10000 M</th>
            <td>@sixResultText</td>
        </tr>
    </table>

<div>
    <h2><strong>Formula Used</strong></h2>
    <p>This page uses a distance-time power law often referred to as a Riegel-style model. In rowing communities, a separate rule-of-thumb called "Paul's Law" is also commonly discussed. Both approaches are best treated as estimate tools for pacing and planning.</p>
    <p><strong>T₂ = T₁ × (D₂ / D₁)exponent</strong></p>

    <h2><strong>Frequently Asked Questions</strong></h2>

    <h4>How accurate are these predictions?</h4>
    <p>Predictions are model-based estimates for planning and journaling. Confidence labels indicate how far you are extrapolating from your known result, and larger extrapolation generally means wider variation.</p>

    <h4>Why do my predictions seem off?</h4>
    <p>Common reasons: profile mismatch, large distance extrapolation, or using a non-representative source piece. Re-check with recent logged efforts and compare both model options.</p>

    <h4>How does this differ from the pace chart?</h4>
    <p>The Pace Chart shows finish times at a constant split. This predictor applies a selected distance model to generate estimate-based pacing and finish-time projections.</p>
</div>

@code {
    private int? distance;
    private int? targetMin;
    private int? targetSec;
    private string? resultText;
    private string? firstResultText;
    private string? secondResultText;
    private string? thirdResultText;
    private string? fiveResultText;
    private string? sixResultText;
    private string errorMessage = "";
    private bool errorCheck = false;


    private int CalculateSplitTime()
    {
        int targetTime = (targetMin.Value * 60) + targetSec.Value;
        double pace = (double)targetTime / distance.Value * 500; 
        return (int)pace;
    }

    private void CalculateAll()
    {
        errorCheck = true;
        errorMessage = "";

        if (distance is null || targetMin is null || targetSec is null)
        {
            errorMessage = "Enter information";
            return;
        }
        if (distance < 0 || distance > 10000)
        {
            errorMessage = "Enter a valid distance";
            return;
        }
        if (targetMin < 0 || targetMin > 30 || 
        targetSec < 0 || targetSec > 59)
        {
            errorMessage = "Enter a valid time";
            return;
        }
        errorCheck = false;
        
        Calculate100();
        Calculate500();
        Calculate1000();
        Calculate2000();
        Calculate5000();
        Calculate10000();

    }
    private void CalculateSplit()
    {
        int time = CalculateSplitTime();
        int minutes = (int)(time / 60);
        double seconds = time % 60;
        resultText = $"{minutes}:{seconds:00}";
        
    }

    private void Calculate100()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(100.0 / distance.Value));
        int totalTime = predic * 100 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        firstResultText = $"{minutes}:{seconds:00}";
    }
    private void Calculate500()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(500.0 / distance.Value));
        int totalTime = predic * 500 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        secondResultText = $"{minutes}:{seconds:00}";
    }
    private void Calculate1000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(1000.0 / distance.Value));
        int totalTime = predic * 1000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        thirdResultText = $"{minutes}:{seconds:00}";
    }
    private void Calculate2000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(2000.0 / distance.Value));
        int totalTime = predic * 2000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        resultText = $"{minutes}:{seconds:00}";
    }
    private void Calculate5000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(5000.0 / distance.Value));
        int totalTime = predic * 5000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        fiveResultText = $"{minutes}:{seconds:00}";
    }
    private void Calculate10000()
    {
        int time = CalculateSplitTime();
        int predic = (int)(time + 5 * Math.Log2(10000.0 / distance.Value));
        int totalTime = predic * 10000 / 500;
        int minutes = (int)(totalTime / 60);
        double seconds = totalTime% 60;
        sixResultText = $"{minutes}:{seconds:00}";
    }
}
