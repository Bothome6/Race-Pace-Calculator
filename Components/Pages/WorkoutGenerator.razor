    private void GenerateTable()
    {
        isSaved = false;
        errorMessage = "Please select an option in each feature.";

        if (string.IsNullOrWhiteSpace(WorkoutFeature.PrimaryGoal))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.ExperienceLevel))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.SessionPerWeek))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.PlanFocus))
        {
            Console.WriteLine(errorMessage);
            return;
        }
        var monday = DateTime.Today.AddDays(
            ((int)DaysOfWeek.monday - (int)DateTime.Today.DayOfWeek + 7) % 7);

            if (monday == DateTime.Today){ monday = monday.AddDays(7);}
            

        int[] session = new int[7];
        int[]? dayOffsets = WorkoutFeature.SessionPerWeek switch
        {
            "1" => new[] {5},
            "2" => new[] {0, 5},
            "3" => new[] {0, 2, 5},
            "4" => new[] {0, 2, 4, 6},
            "5" => new[] {0, 2, 4, 5, 6},
            "6" => new[] {0, 1, 2, 4, 5, 6},
            "7" => new[] {
    0, 1, 2, 3, 4, 5, 6},
            _   => Array.Empty<int>()
        };

        GeneratedSession = dayOffsets.Select((offset, index) => new WorkoutInformation
        {
            SessionNumber = index + 1,
            Description = WorkoutFeature.WorkoutInformation,
            plannedDate = monday.AddDays(dayOffsets)
        }).ToList();


        isSaved = true;
    }

    private async Task SaveTable()
    {
        AuthenticationState? auth = await AuthProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal? user = auth.User;
        string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "Sign in before saving a plan.";
            return;
        }

        Workout? plan = new Workout
        {
            UserID = userId,
            PrimaryGoal = WorkoutFeature.PrimaryGoal,
            ExperienceLevel = WorkoutFeature.ExperienceLevel,
            SessionPerWeek = WorkoutFeature.SessionPerWeek,
            PlanFocus = WorkoutFeature.PlanFocus,
            DateCreated = DateTime.UtcNow,
            @* Sessions = Preview *@
        };

        await using ApplicationDbContext? db = await DbFactory.CreateDbContextAsync();
        db.Workouts.Add(plan);
        await db.SaveChangesAsync();

        errorMessage = "Plan saved.";
    }

}