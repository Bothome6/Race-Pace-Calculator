{
    <div>
        <h5>Workout Plan Generated Successfully</h5>
        <table class="WorkoutGeneratedTable">
            <thead class="TableDarkness">
                <tr>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                    <th>Saturday</th>
                    <th>Sunday</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@WorkoutFeature.PrimaryGoal</td>
                    <td>@WorkoutFeature.ExperienceLevel</td>
                    <td>@WorkoutFeature.SessionPerWeek</td>
                    <td>@WorkoutFeature.PlanFocus</td>
                    <td>@WorkoutFeature.DateCreated.ToShortDateString()</td>
                </tr>
            </tbody>
        </table>
    </div>
}

