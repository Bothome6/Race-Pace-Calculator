    private void GenerateTable()
    {
        isSaved = false;
        errorMessage = "Please select an option in each feature.";

        if (string.IsNullOrWhiteSpace(WorkoutFeature.PrimaryGoal))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.ExperienceLevel))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.SessionPerWeek))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(WorkoutFeature.PlanFocus))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        WorkoutFeature.DateCreated = DateTime.Now;
        isSaved = true;
    }

}