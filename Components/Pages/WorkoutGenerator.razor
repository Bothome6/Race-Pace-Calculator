@page "/workout-generator"
@using System.ComponentModel
@using System.Security.Claims
@using System.Security.Cryptography.Pkcs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.CodeAnalysis.CSharp.Syntax
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuthenticationStateProvider AuthProvider
@using Microsoft.EntityFrameworkCore
@using NEA_Rowing_Calculation_Website.Data
@using NEA_Rowing_Calculation_Website.Model
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<h2>Generate your rowing workout</h2>

<!-- the dropdowns-->
<div>
    <div>
        <label>Primary Goal</label>
        <select @bind="WorkoutFeature.PrimaryGoal">
            <option value="">-- Choose Goal --</option>
            <option value="Fat Loss">Fat Loss</option>
            <option value="Endurance">Endurance</option>
            <option value="2k Test">2k Test Prep</option>
        </select>
    </div>

    <div>
        <label >Experience Level</label>
        <select @bind="WorkoutFeature.ExperienceLevel">
            <option value="">-- Choose Level --</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Experienced">Experienced</option>
        </select>
    </div>

    <div>
        <label >Sessions Per Week</label>
        <select @bind="WorkoutFeature.SessionPerWeek">
            <option value="">-- Choose Frequency --</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </select>
    </div>

    <div>
        <label >Focus</label>
        <select @bind="WorkoutFeature.PlanFocus">
            <option value="">-- Choose Focus --</option>
            <option value="Technique">Technique</option>
            <option value="Power">Power</option>
            <option value="Cardio">Cardio</option>
        </select>
    </div>

    @if (WorkoutFeature.PrimaryGoal == "2k Test")
    {
    <h4>Enter Current 2k Split</h4>
    <p>If you have done one.</p>

    <div>
        <label for="quantity" >Minutes:</label>
        <input type="number" id="quantity" name="quantity" @bind="CurrentMin" />
    </div>

    <div>
        <label for="quantity" >Seconds:</label>
        <input type="number" id="quantity" name="quantity" @bind="CurrentSec" />
    </div>
    }

    <div>
        <button @onclick="Generating">Generate Table</button>
    </div>
    <div>
        <label class="errormessage">@errorMessage</label>
    </div>
</div>

<!--layout of the table-->
@if (saved)
{
    <div>
        <h5>Workout Plan</h5>
        <table class="WorkoutGeneratedTable">
            <thead class="TableDarkness">
                <tr>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                    <th>Saturday</th>
                    <th>Sunday</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@GetWorkoutForDay(DayOfWeek.Monday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Tuesday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Wednesday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Thursday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Friday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Saturday)</td>
                    <td>@GetWorkoutForDay(DayOfWeek.Sunday)</td>
                </tr>
            </tbody>
        </table>
    </div>
}

    <div>
        <button @onclick="saving">Save Table</button>
    </div>

@code
{
    private Workout WorkoutFeature = new Workout();
    private bool saved = false;
    private int CurrentMin;
    private int CurrentSec;
    string errorMessage = "";
    private string? resultText;
    private List<WorkoutSession> GeneratedSessions {get;set;} = new List<WorkoutSession>();
    private string? userId;

    <!--finds a workout specific to a day-->
    public string GetWorkoutForDay(DayOfWeek day)
    {
        return GeneratedSessions
        .FirstOrDefault(session => session.PlannedDate.DayOfWeek == day)
        ?.TaskDescription;
    }

    <!--identifying the page to the user-->
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    <!--replace "2k split" with the users 2k-->
    private string Change2kDescription(int index)
    {
        var description = WorkoutFeature.WorkoutInformation[index];

        if (WorkoutFeature.PrimaryGoal == "2k Test" &&
        !string.IsNullOrWhiteSpace(resultText))
    {
        description = description.Replace("2k split", resultText);
    }

    return description;
    }

        
    <!--generating the table layout-->
    private void Generating()
    {

        saved = false;
        errorMessage = "Please select an option in each feature.";

        <!--error message-->
        if (string.IsNullOrWhiteSpace(WorkoutFeature.PrimaryGoal) ||
        string.IsNullOrWhiteSpace(WorkoutFeature.ExperienceLevel) ||
        string.IsNullOrWhiteSpace(WorkoutFeature.SessionPerWeek) || 
        string.IsNullOrWhiteSpace(WorkoutFeature.PlanFocus))
        {
            Console.WriteLine(errorMessage);
            return;
        }

        <!--2k user info-->
        if (WorkoutFeature.PrimaryGoal == "2k Test")
        {
            if (CurrentMin < 0 || CurrentMin > 10 || 
            CurrentSec < 0 || CurrentSec > 59)
            {
                errorMessage = "Enter a valid time";
                return;
            }
            resultText = $"{CurrentMin}:{CurrentSec:00}"; 
        }


        var Monday = DateTime.Today.AddDays(
            ((int)DayOfWeek.Monday - (int)DateTime.Today.DayOfWeek + 6) % 6);

        if (Monday == DateTime.Today){ Monday = Monday.AddDays(6);}

        <!--sets the days of the workouts depending on amount of workouts from user-->
        int[] session = new int[6];
        int[]? dayOffsets = WorkoutFeature.SessionPerWeek switch
        {
            "1" => new[] {5},
            "2" => new[] {0, 5},
            "3" => new[] {0, 2, 5},
            "4" => new[] {0, 2, 4, 6},
            "5" => new[] {0, 2, 4, 5, 6},
            "6" => new[] {0, 1, 2, 4, 5, 6},
            _   => Array.Empty<int>()
        };

        GeneratedSessions = dayOffsets.Select((offset, index) => new WorkoutSession
        {
            SessionNumber = index + 1,
            TaskDescription = Change2kDescription(index),
            PlannedDate = Monday.AddDays(offset)
        }).ToList();

        saved = true;
    }

    private async Task saving()
    {
        AuthenticationState? auth = await AuthProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal? user = auth.User;
        string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "Sign in before saving a plan.";
            return;
        }

        Workout? plan = new Workout
        {
            UserID = userId,
            PrimaryGoal = WorkoutFeature.PrimaryGoal,
            ExperienceLevel = WorkoutFeature.ExperienceLevel,
            SessionPerWeek = WorkoutFeature.SessionPerWeek,
            PlanFocus = WorkoutFeature.PlanFocus,
            DateCreated = DateTime.Now,
            Sessions =  GeneratedSessions
        };

        await using ApplicationDbContext? db = await DbFactory.CreateDbContextAsync();
        db.Workouts.Add(plan);
        await db.SaveChangesAsync();

        errorMessage = "Plan saved.";
    }
}