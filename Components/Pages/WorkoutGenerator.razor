@page "/workout-generator"
@using NEA_Rowing_Calculation_Website.Model
@rendermode InteractiveServer
@inject

<h2>Generate your rowing workout</h2>

<div>
    <!-- Primary Goal -->
    <div>
        <label>Primary Goal</label>
        <select @bind="ApplicationDbContext.PrimaryGoal">
            <option value="">-- Choose Goal --</option>
            <option value="FatLoss">Fat Losse</option>
            <option value="Endurance">Endurance</option>
            <option value="2kTest">2k Test Prep</option>
        </select>
    </div>

    <div>
        <!--Experience Level-->
        <label >Experience Level</label>
        <select @bind="Workout.ExperienceLevel">
            <option value="">-- Choose Level --</option>
            <option value="Beginner">Beginner</option>
            <option value="Intermediate">Intermediate</option>
            <option value="Experienced">Experienced</option>
        </select>
    </div>

    <div>
        <!--Session Per Week-->
        <label >Sessions Per Week</label>
        <select @bind="Workout.SessionsPerWeek">
            <option value="">-- Choose Frequency --</option>
            <option value="1-2">1-2</option>
            <option value="3-4">3-4</option>
            <option value="5-6">5-6</option>
            <option value="7">7</option>
        </select>
    </div>

    <div>
        <!--Focus-->
        <label >Focus</label>
        <select @bind="Workout.PlanFocus">
            <option value="">-- Choose Focus --</option>
            <option value="Technique">Technique</option>
            <option value="Power">Power</option>
            <option value="Cardio">Cardio</option>
        </select>
    </div>

    <div>
        <button @onclick="SaveGenerateWorkout">Save & Generate Workout</button>
    </div>
</div>

@if (isSaved)
    <div>
        <h5>Workout Plan Generated Successfully</h5>
        <table class="WorkoutGeneratedTable">
            <thead class="TableDarkness">
                <tr>
                    <th>Goal</th>
                    <th>Experience</th>
                    <th>Sessions</th>
                    <th>Focus</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Workout.PrimaryGoal</td>
                    <td>@Workout.ExperienceLevel</td>
                    <td>@Workout.SessionPerWeek</td>
                    <td>@Workout.PlanFocus</td>
                    <td>@Workout.DateCreated.ToShortDateString()</td>
                </tr>
            </tbody>
        </table>
    </div>