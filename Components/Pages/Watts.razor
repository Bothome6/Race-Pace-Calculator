@page "/watts"
@rendermode InteractiveServer

<h3>Watts Calculator</h3>

<div>
    <label>Distance (meters):</label>
    <input type="number" @bind="distance" />
</div>
<h4>Target Time</h4>
<div>
    <label>Minutes:</label>
    <input type="number" @bind="targetMin" />
</div>

<div>
    <label>Seconds:</label>
    <input type="number" @bind="targetSec" />
</div>

<div>
    <button class="CalculateButton" @onclick="CalculateWatts">Calculate</button>
</div>

<div>
    <label class="errormessage">@errorMessage</label>
</div>

@if (resultText != null)
{
    <p><b>@resultText</b></p>
}

<div>
    <h2><strong>Formula Used</strong></h2>
    <p>Both watt conversions use the standard power-pace relationship derived from rowing physics: Watts = 2.8 ÷ (split_sec / 500)³. The relationship is cubic — going from 2:00 to 1:55 costs ~18 watts, but going from 1:35 to 1:30 costs ~45 watts for the same 5-second gain. The faster you row, the more expensive each second becomes.</p>
    <p><strong>watts = 2.80/pace³</strong></p>
    <p><strong>pace = ³√(2.80/watts)</strong></p>

    <p>For example: a 2:05/500m split = 125 seconds/500 meters or a 0.25 pace. Watts are then calculated as (2.80/0.25 ^ 3) or (2.80/0.015625), which equals 179.2.</p>
</div>

@code {
    private int? distance;
    private int? targetMin;
    private int? targetSec;
    private string ?resultText;
    private string errorMessage = "";

    private double CalculateSplit()
    {
        int targetTime = (targetMin.Value * 60) + targetSec.Value;
        double pace = (double)targetTime / distance.Value * 500;
        double minutes = (pace / 60);
        double seconds = pace % 60;
        resultText = $"{minutes}:{seconds:00}";
        return (double)pace;
    }

    private double CalculatePace()
    {
        double split = CalculateSplit();
        return split / 500.0;
    }

    private void CalculateWatts()
    {
        resultText = null;
        errorMessage = "";

        if (distance is null || targetMin is null || targetSec is null)
        {
            errorMessage = "Enter information";
            return;
        }
        if (distance < 0 || distance > 100000)
        {
            errorMessage = "Enter a valid distance";
            return;
        }
        if (targetMin < 0 || targetMin > 30 || 
        targetSec < 0 || targetSec > 59)
        {
            errorMessage = "Enter a valid time";
            return;
        }

        double pace = CalculatePace();
        double watts = Math.Round(2.80/ Math.Pow(pace,3));
        resultText = $"Watts: {watts}";
    }
    
}