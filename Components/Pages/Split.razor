@page "/split-calculator"
@using System.Runtime.CompilerServices
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<h3>Split Calculator</h3>

<div>
    <label for="quantity">Distance (meters):</label>
    <input type="number" id="quantity name="quantity" @bind="distance" />
</div>

<h4>Target Time</h4>

<div>
    <label for="quantity" >Minutes:</label>
    <input type="number" id="quantity name="quantity" @bind="targetMin" />
</div>

<div>
    <label for="quantity" >Seconds:</label>
    <input type="number" id="quantity name="quantity" @bind="targetSec" />
</div>

<div>
    <button class="CalculateButton" @onclick="CalculateSplit">Calculate</button>
</div>


<div>
    <label class="errorMessgae">@errorMessage</label>
</div>



@if (resultText != null)
{
    <p><b>Your split: @resultText</b></p>
}


@code {
    private int? distance;
    private int? targetMin;
    private int? targetSec;
    private string? resultText;
    public string errorMessage = "";




    private void CalculateSplit()
    {
        resultText = null;
        errorMessage = "";

        if (distance is null || targetMin is null || targetSec is null)
        {
            errorMessage = "Enter information";
            return;
        }
        if (distance < 0 || distance > 10000)
        {
            errorMessage = "Enter a valid distance";
            return;
        }
        if (targetMin < 0 || targetMin > 30 || 
        targetSec < 0 || targetSec > 59)
        {
            errorMessage = "Enter a valid time";
            return;
        }

        int targetTime = (targetMin.Value * 60) + targetSec.Value;
        double pace = (double)targetTime / distance.Value * 500;
        int  minutes = (int)(pace / 60);
        double seconds = pace % 60;
        resultText = $"{minutes}:{seconds:00}"; 
    }
}